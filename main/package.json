{
  "name": "exiled-exchange-2",
  "version": "0.15.8",
  "private": true,
  "scripts": {
    "dev": "node build/script.mjs",
    "postinstall": "electron-rebuild -f -w @u4/opencv4nodejs",
    "build": "tsc --noEmit && node build/script.mjs --prod",
    "package": "electron-builder build",
    "lint": "eslint src",
    "fix": "eslint src --fix",
    "check-types": "tsc --noemit",
    "format": "prettier . --write "
  },
  "author": {
    "name": "Garrett Parker"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Kvan7/exiled-exchange-2.git"
  },
  "main": "dist/main.js",
  "dependencies": {
    "@techstark/opencv-js": "^4.12.0-release.1",
    "@u4/opencv4nodejs": "^7.1.2",
    "canvas": "^3.2.3",
    "electron-overlay-window": "4.1.0",
    "jsdom": "^29.1.1",
    "uiohook-napi": "1.5.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.1.0",
    "@types/ini": "^4.1.0",
    "@types/node": "22.x.x",
    "@types/ws": "^8.5.3",
    "@wokwi/bmp-ts": "^3.0.0",
    "comlink": "^4.3.1",
    "electron": "^40.9.1",
    "electron-builder": "^26.15.3",
    "electron-devtools-installer": "^4.0.0",
    "electron-updater": "^6.8.3",
    "esbuild": "^0.28.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "ini": "^6.0.0",
    "prettier": "3.4.2",
    "typescript": "5.9.x",
    "ws": "^8.16.0"
  },
  "optionalDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "eslint": "^9.39.4",
    "eslint-config-love": "^154.0.0"
  },
  "overrides": {
    "yauzl": "^3.3.1",
    "glob": "^13.0.6",
    "rimraf": "^4.4.1"
  },
  "opencv4nodejs": {
    "disableAutoBuild": "1"
  }
}
